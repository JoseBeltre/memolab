# Copia este archivo a `.env` y completa los valores con los datos de tu proyecto de Supabase.
# URL del proyecto (Settings > API > Project URL)
NUXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publica "anon" (Settings > API > Project API keys)
NUXT_PUBLIC_SUPABASE_KEY=TU-CLAVE-ANON-PUBLICA
